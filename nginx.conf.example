server {
    listen 5000 ssl;
    server_name 192.168.15.189; # Ganti dengan IP VPS atau Domain Anda

    # Konfigurasi SSL / HTTPS
    ssl_certificate     /etc/nginx/ssl/nginx-selfsigned.crt;
    ssl_certificate_key /etc/nginx/ssl/nginx-selfsigned.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Redirect otomatis jika diakses via HTTP pada port 5000
    # error_page 497 = @redirect_https;
    # location @redirect_https {
    #    return 301 https://$host:5000$request_uri;
    # }
    error_page 497 =301 https://$host:5000$request_uri;

    client_max_body_size 100M; # Sesuaikan jika sering upload file Excel / foto besar

    # Proxy request ke Gunicorn (port 8001)
    location / {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_connect_timeout 300s;
    }

    # (Opsional & Direkomendasikan) Melayani folder uploads langsung via Nginx untuk performa maksimal
    location /uploads {
        alias /var/www/html/website_stok_stiker/uploads;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }
}
